{
  "name": "tedge-dot-ui",
  "version": "0.0.22",
  "description": "Cumulocity Device Management plugin to edit tedge-dot connector files and install them on thin-edge.io gateways",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-site.mjs",
    "prestart": "npm run sync",
    "start": "ng serve",
    "changelog": "node scripts/changelog.mjs",
    "prebuild": "npm run sync && npm run changelog",
    "build": "ng build",
    "pretest": "npm run sync",
    "test": "jest",
    "pretypecheck": "npm run sync",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/upgrade": "^22.0.0",
    "@c8y/bootstrap": "1025.12.0",
    "@c8y/client": "1025.12.0",
    "@c8y/ngx-components": "1025.12.0",
    "@c8y/style": "1025.12.0",
    "@decimalturn/toml-patch": "3.3.2",
    "ajv": "^8.20.0",
    "monaco-editor": "0.57.0",
    "ngx-bootstrap": "22.0.0",
    "rxjs": "7.8.2",
    "smol-toml": "^1.6.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@c8y/devkit": "1025.12.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "c8y": {
    "application": {
      "name": "tedge-dot OT connectors",
      "description": "Edit tedge-dot connector files in a form or as TOML, build OPC UA points from an address-space scan, and install them on thin-edge.io gateways",
      "contextPath": "tedge-dot-ui",
      "key": "tedge-dot-ui-application-key",
      "globalTitle": "tedge-dot OT connectors",
      "isPackage": true,
      "noAppSwitcher": true,
      "package": "plugin",
      "exports": [
        {
          "name": "OT connectors",
          "module": "TedgeDotConnectorsModule",
          "path": "./src/connectors.module.ts",
          "description": "Adds OT connectors to the Management menu and an OT connectors tab to thin-edge.io devices",
          "readmePath": "README.md"
        }
      ]
    }
  }
}
